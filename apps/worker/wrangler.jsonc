{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dockmark",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "AUTH_MODE": "development",
    "APP_VERSION": "0.1.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dockmark",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "dockmark",
      "vars": {
        "AUTH_MODE": "builtin",
        "APP_VERSION": "0.1.0",
        "SESSION_COOKIE_NAME": "dockmark_session",
        "SESSION_TTL_SECONDS": "604800",
        "PASSWORD_PBKDF2_ITERATIONS": "310000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dockmark-production",
          "migrations_dir": "../../migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV"
        }
      ]
    }
  }
}
