{
  "name": "@dockmark/worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "echo \"No worker format yet\"",
    "db:migrate:local": "wrangler d1 migrations apply dockmark --local",
    "db:migrate:remote": "wrangler d1 migrations apply dockmark --remote",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@dockmark/shared": "workspace:*",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.4.0"
  }
}
