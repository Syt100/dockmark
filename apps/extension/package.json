{
  "name": "@dockmark/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm run build && node --test test/**/*.test.mjs",
    "lint": "corepack pnpm run lint:check",
    "lint:check": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "corepack pnpm --dir ../.. exec prettier --write apps/extension",
    "format": "corepack pnpm --dir ../.. exec prettier --write apps/extension"
  },
  "devDependencies": {
    "typescript": "~6.0.0"
  }
}
