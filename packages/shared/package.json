{
  "name": "@dockmark/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "corepack pnpm run lint:check",
    "lint:check": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "corepack pnpm --dir ../.. exec prettier --write packages/shared",
    "format": "corepack pnpm --dir ../.. exec prettier --write packages/shared"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  }
}
